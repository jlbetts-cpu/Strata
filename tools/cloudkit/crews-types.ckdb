    RECORD TYPE Crew (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        createdAt          TIMESTAMP,
        name               STRING,
        ownerProfileID     STRING,
        photo              ASSET,
        timeZoneIdentifier STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Member (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        firstName STRING,
        head      ASSET,
        joinedAt  TIMESTAMP,
        photo     ASSET,
        profileID STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SharedWin (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        blockSize       STRING,
        colour          STRING,
        createdAt       TIMESTAMP,
        crewDay         STRING,
        cropX           DOUBLE,
        cropY           DOUBLE,
        icon            STRING,
        photo           ASSET,
        senderProfileID STRING,
        title           STRING,
        withPeople      STRING,
        updatedAt       TIMESTAMP,
        winID           STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Reaction (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        createdAt TIMESTAMP,
        emoji     STRING,
        line      STRING,
        profileID STRING,
        sketch    ASSET,
        winID     STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // The crew's day chat (2026-10-05): a line, or a doodle, quoting a win
    // when it is a reply. Each phone deletes its own at the crew's midnight.
    RECORD TYPE CrewMessage (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        createdAt       TIMESTAMP,
        crewDay         STRING,
        messageID       STRING,
        quoteWinID      STRING,
        senderProfileID STRING,
        sketch          ASSET,
        text            STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Identity (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        profileID STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // Reports go to the PUBLIC database. Anyone signed in may file one, and
    // only the Moderator role (the developer) may read them: not "_world",
    // and since 2026-10-08 not their writer either.
    RECORD TYPE Report (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        crew     STRING,
        reason   STRING,
        reporter STRING,
        sender   STRING,
        title    STRING,
        winID    STRING,
        GRANT READ TO Moderator,
        GRANT CREATE TO "_icloud"
    );

    // The system type every CKShare is saved as. A container that has never
    // saved a share in development has no such type, and production refuses
    // it: "Cannot create new type cloudkit.share in production schema" (the
    // first crew on a phone, 2026-10-02).
    RECORD TYPE "cloudkit.share" (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "cloudkit.title"              STRING,
        "cloudkit.thumbnailImageData" BYTES,
        "cloudkit.type"               STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
