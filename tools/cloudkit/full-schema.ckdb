DEFINE SCHEMA

    CREATE ROLE Moderator;

    // A Ban is read by every phone. Its `reason` is never written since
    // 2026-10-08 (a field cannot be removed from a production schema); why
    // someone was banned lives in BanNote, which only the Moderator reads.
    RECORD TYPE Ban (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        account         STRING QUERYABLE,
        reason          STRING,
        GRANT CREATE, WRITE TO Moderator,
        GRANT READ TO "_world"
    );

    // Why an account was banned (2026-10-08). Moderator only, never "_world":
    // the reason used to sit on the Ban record itself, which every phone reads.
    RECORD TYPE BanNote (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        account         STRING,
        reason          STRING,
        GRANT CREATE, READ, WRITE TO Moderator
    );

    RECORD TYPE Crew (
        "___createTime"    TIMESTAMP,
        "___createdBy"     REFERENCE,
        "___etag"          STRING,
        "___modTime"       TIMESTAMP,
        "___modifiedBy"    REFERENCE,
        "___recordID"      REFERENCE QUERYABLE,
        createdAt          TIMESTAMP,
        name               STRING,
        ownerProfileID     STRING,
        photo              ASSET,
        timeZoneIdentifier STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Identity (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        profileID       STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Member (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        firstName       STRING,
        head            ASSET,
        joinedAt        TIMESTAMP,
        photo           ASSET,
        profileID       STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Ping (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        crew            STRING QUERYABLE,
        kind            STRING QUERYABLE,
        recipient       STRING QUERYABLE,
        sender          STRING QUERYABLE,
        win             STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Reaction (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        createdAt       TIMESTAMP,
        emoji           STRING,
        profileID       STRING,
        winID           STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // Create only, for anyone signed in; read only by the Moderator role
    // (2026-10-08). The writer could read and rewrite their own report,
    // which a report never needs once filed.
    RECORD TYPE Report (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        crew            STRING,
        photo           ASSET,
        reason          STRING,
        reporter        STRING,
        sender          STRING,
        senderAccount   STRING,
        title           STRING,
        winID           STRING,
        GRANT READ TO Moderator,
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE SharedWin (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        blockSize       STRING,
        colour          STRING,
        createdAt       TIMESTAMP,
        crewDay         STRING,
        cropX           DOUBLE,
        cropY           DOUBLE,
        icon            STRING,
        photo           ASSET,
        senderProfileID STRING,
        title           STRING,
        updatedAt       TIMESTAMP,
        winID           STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE "cloudkit.share" (
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE,
        "cloudkit.thumbnailImageData" BYTES,
        "cloudkit.title"              STRING,
        "cloudkit.type"               STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
